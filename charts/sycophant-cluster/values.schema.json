{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyEngine"],
  "properties": {
    "global": { "type": "object" },
    "policyEngine": {
      "description": "Admission-policy engine: 'kyverno' renders the framework ClusterPolicies, 'external' renders none. No default — you must declare one.",
      "enum": ["kyverno", "external"]
    },
    "deployer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" }
          }
        }
      }
    }
  }
}
