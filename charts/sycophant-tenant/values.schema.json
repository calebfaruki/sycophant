{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "storageClass": {
      "type": "string",
      "description": "StorageClass for all tenant PVCs. Empty uses the cluster default StorageClass."
    },
    "vpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "hangarCtrl": { "$ref": "#/$defs/vpaTarget" },
    "airlockCtrl": { "$ref": "#/$defs/vpaTarget" },
    "mainframeCtrl": { "$ref": "#/$defs/vpaTarget" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "llmJobImage": { "type": "string" }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "airlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "transponder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "mainframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "kernels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostPathBase": { "type": "string" }
          }
        }
      }
    },
    "installWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workspaceInit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workspaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transponder": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes CPU quantity for the transponder container (requests = limits)."
              },
              "memory": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes memory quantity for the transponder container (requests = limits)."
              }
            }
          },
          "storage": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace PVC size. Defaults to 1Gi when absent."
          },
          "conversationStorage": {
            "type": "string",
            "minLength": 1,
            "description": "Conversation-history PVC size for this workspace's transponder. Defaults to 1Gi."
          },
          "chambers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "kernel": {
            "type": "object",
            "additionalProperties": false,
            "description": "CLI-populated by `syco tenant up` from the workspace's Kernel CR (optional custom hostPath). Not hand-edited.",
            "properties": {
              "path": { "type": "string", "pattern": "^/.+" }
            }
          }
        }
      }
    },
    "headscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "serverUrl": {
          "type": "string",
          "description": "Public URL clients use to reach headscale. Required when enabled=true."
        },
        "magicDns": { "type": "boolean" },
        "baseDomain": { "type": "string" },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "email": {
              "type": "string",
              "description": "Email registered with Let's Encrypt. Required when acme.enabled=true."
            }
          }
        }
      }
    },
    "tsnetBridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "loginServer": {
          "type": "string",
          "description": "Headscale URL the bridge joins. Defaults to the in-cluster headscale Service when both are enabled."
        },
        "hostname": { "type": "string" },
        "authKeySecret": {
          "type": "string",
          "description": "Pre-existing Secret with key `authkey` (headscale pre-auth key)."
        }
      }
    }
  },
  "$defs": {
    "vpaTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAllowed": { "$ref": "#/$defs/resourceQuantity" },
            "maxAllowed": { "$ref": "#/$defs/resourceQuantity" }
          }
        }
      }
    },
    "resourceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    }
  }
}
