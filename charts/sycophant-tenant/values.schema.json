{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "storageClass": {
      "type": "string",
      "description": "StorageClass for all tenant PVCs. Empty uses the cluster default StorageClass."
    },
    "vpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "toolsetCtrl": { "$ref": "#/$defs/vpaTarget" },
    "toolset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "toolsets": {
      "type": "object",
      "description": "Toolset entries rendered into the toolset-config ConfigMap. Keyed by toolset name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image"],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "Tool job image the controller spawns for this toolset."
          },
          "keepalive": {
            "type": "boolean",
            "description": "Keep the tool job warm: Job restartPolicy OnFailure plus idle-reap instead of one-shot."
          },
          "env": {
            "type": "object",
            "description": "Env vars forwarded verbatim into the tool job: key as the name, scalar as the value.",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prompt configuration: the turn server. Read directly by the controller, never looked up by name in the toolsets map, and bound by no workspace.",
      "properties": {
        "profiles": {
          "type": "object",
          "description": "Model name to prompt profile. The key IS the turn's `model` value; an absent key is refused, never defaulted.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image", "format", "model", "baseUrl", "secret"],
            "properties": {
              "image": {
                "type": "string",
                "minLength": 1,
                "description": "Prompt Job image the controller spawns for this profile."
              },
              "format": {
                "type": "string",
                "enum": ["anthropic", "openai", "gemini"],
                "description": "Provider wire format the prompt image speaks."
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "The provider's own model id, which need not match the profile key."
              },
              "baseUrl": {
                "type": "string",
                "minLength": 1,
                "description": "Provider API base URL, passed as-is including any version path (e.g. https://api.anthropic.com/v1)."
              },
              "secret": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes Secret carrying the provider credential, mounted read-only into the prompt Job."
              },
              "egress": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["domain", "port"],
                  "properties": {
                    "domain": { "type": "string", "minLength": 1 },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "kernels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostPathBase": { "type": "string" }
          }
        }
      }
    },
    "installWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workspaceInit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workspaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes CPU quantity for the harness container (requests = limits)."
              },
              "memory": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes memory quantity for the harness container (requests = limits)."
              }
            }
          },
          "storage": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace PVC size. Defaults to 1Gi when absent."
          },
          "conversationStorage": {
            "type": "string",
            "minLength": 1,
            "description": "Conversation-history PVC size for this workspace's harness. Defaults to 1Gi."
          },
          "toolsets": {
            "type": "array",
            "description": "Toolsets this workspace is bound to. An item is either a bare toolset name or an object naming the toolset and the grant menu calls may select from.",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "grants"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "grants": {
                      "type": "object",
                      "description": "The closed set of credentials a tool call against this toolset may select. Keyed by grant name.",
                      "minProperties": 1,
                      "propertyNames": {
                        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                        "maxLength": 63
                      },
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["secret"],
                        "properties": {
                          "secret": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Kubernetes Secret carrying the credential under a data key equal to the Secret's own name."
                          },
                          "path": {
                            "type": "string",
                            "pattern": "^/.+",
                            "description": "Absolute path the credential file lands at. Defaults to /run/secrets/grant/credential."
                          },
                          "egress": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The one domain the chart opens for this grant. A grant declaring none stays on the baseline floor."
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "kernel": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional absolute host directory serving this workspace's kernel content, overriding the convention path <hostPathBase>/<namespace>/<workspace>. Managed by 'syco tenant kernel set' / 'delete'.",
            "properties": {
              "path": { "type": "string", "pattern": "^/.+" }
            }
          }
        }
      }
    },
    "headscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "serverUrl": {
          "type": "string",
          "description": "Public URL clients use to reach headscale. Required when enabled=true."
        },
        "magicDns": { "type": "boolean" },
        "baseDomain": { "type": "string" },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "email": {
              "type": "string",
              "description": "Email registered with Let's Encrypt. Required when acme.enabled=true."
            }
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "description": "Channel instances this tenant serves. The map key is the instance name and becomes the pod's sycophant.md/channel label; presence in the map is the enable signal.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["app"],
            "description": "Channel kind. Phase 1 supports only \"app\"."
          },
          "image": { "type": "string" },
          "tag": { "type": "string" },
          "pullPolicy": {
            "type": "string",
            "enum": ["Always", "IfNotPresent", "Never"]
          },
          "loginServer": {
            "type": "string",
            "description": "Headscale URL the adapter joins. Required."
          },
          "hostname": { "type": "string" },
          "authKeySecret": {
            "type": "string",
            "description": "Pre-existing Secret with key `authkey` (headscale pre-auth key)."
          }
        }
      }
    }
  },
  "$defs": {
    "vpaTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAllowed": { "$ref": "#/$defs/resourceQuantity" },
            "maxAllowed": { "$ref": "#/$defs/resourceQuantity" }
          }
        }
      }
    },
    "resourceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    }
  }
}
