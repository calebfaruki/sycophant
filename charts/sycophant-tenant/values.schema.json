{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "controllers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adversarialAntiAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "vpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "tightbeamCtrl": { "$ref": "#/$defs/vpaTarget" },
    "airlockCtrl": { "$ref": "#/$defs/vpaTarget" },
    "mainframeCtrl": { "$ref": "#/$defs/vpaTarget" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "llmJobImage": { "type": "string" }
      }
    },
    "airlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "transponder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "mainframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "workspaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transponder": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes CPU quantity for the transponder container (requests = limits)."
              },
              "memory": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes memory quantity for the transponder container (requests = limits)."
              }
            }
          },
          "storage": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace PVC size. Defaults to 1Gi when absent."
          },
          "chambers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "kernel": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["HostPath", "S3"]
              },
              "hostPath": {
                "type": "object",
                "required": ["path"],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^/.+"
                  }
                }
              },
              "s3": {
                "type": "object",
                "required": ["endpoint", "bucket", "prefix", "region", "forcePathStyle", "credentials"],
                "additionalProperties": false,
                "properties": {
                  "endpoint": { "type": "string" },
                  "bucket": { "type": "string" },
                  "prefix": { "type": "string" },
                  "region": { "type": "string" },
                  "forcePathStyle": { "type": "boolean" },
                  "credentials": {
                    "type": "object",
                    "required": ["name"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string" },
                      "accessKeyIdKey": { "type": "string" },
                      "secretAccessKeyKey": { "type": "string" }
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "HostPath" } } },
                "then": { "required": ["hostPath"] }
              },
              {
                "if": { "properties": { "kind": { "const": "S3" } } },
                "then": { "required": ["s3"] }
              }
            ]
          }
        }
      }
    },
    "chambers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "image": { "type": "string" },
          "egress": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["domain", "port"],
              "properties": {
                "domain": { "type": "string", "minLength": 1 },
                "port":   { "type": ["string", "integer"] }
              }
            }
          },
          "credentials": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "keepalive": { "type": "boolean" }
        }
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["workspaces"],
        "additionalProperties": false,
        "properties": {
          "workspaces": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "tightbeam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["LocalFs", "S3"]
            },
            "s3": {
              "type": "object",
              "additionalProperties": false,
              "required": ["endpoint", "bucket", "prefix", "region", "forcePathStyle", "credentials"],
              "properties": {
                "endpoint": { "type": "string" },
                "bucket": { "type": "string" },
                "prefix": { "type": "string" },
                "region": { "type": "string" },
                "forcePathStyle": { "type": "boolean" },
                "credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "accessKeyIdKey": { "type": "string" },
                    "secretAccessKeyKey": { "type": "string" }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "S3" } } },
              "then": { "required": ["s3"] }
            }
          ]
        }
      }
    },
    "headscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "serverUrl": {
          "type": "string",
          "description": "Public URL clients use to reach headscale. Required when enabled=true."
        },
        "magicDns": { "type": "boolean" },
        "baseDomain": { "type": "string" },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "email": {
              "type": "string",
              "description": "Email registered with Let's Encrypt. Required when acme.enabled=true."
            }
          }
        }
      }
    },
    "tsnetBridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "loginServer": {
          "type": "string",
          "description": "Headscale URL the bridge joins. Defaults to the in-cluster headscale Service when both are enabled."
        },
        "hostname": { "type": "string" },
        "authKeySecret": {
          "type": "string",
          "description": "Pre-existing Secret with key `authkey` (headscale pre-auth key)."
        }
      }
    }
  },
  "$defs": {
    "vpaTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAllowed": { "$ref": "#/$defs/resourceQuantity" },
            "maxAllowed": { "$ref": "#/$defs/resourceQuantity" }
          }
        }
      }
    },
    "resourceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    }
  }
}
