{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "storageClass": {
      "type": "string",
      "description": "StorageClass for all tenant PVCs. Empty uses the cluster default StorageClass."
    },
    "vpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "toolsetCtrl": { "$ref": "#/$defs/vpaTarget" },
    "toolset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "toolsets": {
      "type": "object",
      "description": "Toolset entries rendered into the toolset-config ConfigMap. Keyed by toolset name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "Worker pod image the controller spawns for this toolset."
          },
          "keepalive": {
            "type": "boolean",
            "description": "Keep the worker warm: Job restartPolicy OnFailure plus idle-reap instead of one-shot."
          },
          "profiles": {
            "type": "object",
            "description": "Profile key to profile. Static toolsets carry one profile keyed by the toolset name.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "secrets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["secret"],
                    "properties": {
                      "secret": { "type": "string", "minLength": 1 },
                      "env": { "type": "string", "minLength": 1 },
                      "file": { "type": "string", "pattern": "^/.+" }
                    },
                    "oneOf": [
                      { "required": ["env"], "not": { "required": ["file"] } },
                      { "required": ["file"], "not": { "required": ["env"] } }
                    ]
                  }
                },
                "egress": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["domain", "port"],
                    "properties": {
                      "domain": { "type": "string", "minLength": 1 },
                      "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                    }
                  }
                }
              },
              "additionalProperties": {
                "type": ["string", "number", "boolean"],
                "description": "Inert profile key forwarded verbatim into the worker as an env var."
              }
            }
          }
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "kernels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostPathBase": { "type": "string" }
          }
        }
      }
    },
    "installWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workspaceInit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workspaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes CPU quantity for the harness container (requests = limits)."
              },
              "memory": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes memory quantity for the harness container (requests = limits)."
              }
            }
          },
          "storage": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace PVC size. Defaults to 1Gi when absent."
          },
          "conversationStorage": {
            "type": "string",
            "minLength": 1,
            "description": "Conversation-history PVC size for this workspace's harness. Defaults to 1Gi."
          },
          "toolsets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "kernel": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional absolute host directory serving this workspace's kernel content, overriding the convention path <hostPathBase>/<namespace>/<workspace>. Managed by 'syco tenant kernel set' / 'delete'.",
            "properties": {
              "path": { "type": "string", "pattern": "^/.+" }
            }
          }
        }
      }
    },
    "headscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "serverUrl": {
          "type": "string",
          "description": "Public URL clients use to reach headscale. Required when enabled=true."
        },
        "magicDns": { "type": "boolean" },
        "baseDomain": { "type": "string" },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "email": {
              "type": "string",
              "description": "Email registered with Let's Encrypt. Required when acme.enabled=true."
            }
          }
        }
      }
    },
    "tsnetBridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "loginServer": {
          "type": "string",
          "description": "Headscale URL the bridge joins. Defaults to the in-cluster headscale Service when both are enabled."
        },
        "hostname": { "type": "string" },
        "authKeySecret": {
          "type": "string",
          "description": "Pre-existing Secret with key `authkey` (headscale pre-auth key)."
        }
      }
    }
  },
  "$defs": {
    "vpaTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAllowed": { "$ref": "#/$defs/resourceQuantity" },
            "maxAllowed": { "$ref": "#/$defs/resourceQuantity" }
          }
        }
      }
    },
    "resourceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    }
  }
}
