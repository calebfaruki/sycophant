{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "llmJobImage": { "type": "string" }
      }
    },
    "airlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "transponder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "mainframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag"],
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "workspaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["image", "tag"],
        "additionalProperties": false,
        "properties": {
          "image": { "type": "string" },
          "tag": { "type": "string" },
          "pullPolicy": {
            "type": "string",
            "enum": ["Always", "IfNotPresent", "Never"]
          },
          "chambers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/.+",
            "description": "Absolute host filesystem path. The workspace pod mounts this directory read-only at /etc/mainframe via a hostPath volume."
          }
        }
      }
    },
    "chambers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": { "type": "string" },
          "keepalive": { "type": "boolean" },
          "credentials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["secret"],
              "additionalProperties": false,
              "properties": {
                "secret": { "type": "string" },
                "env": { "type": "string" },
                "file": { "type": "string" }
              }
            }
          },
          "egress": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["host", "port"],
              "additionalProperties": false,
              "properties": {
                "host": { "type": "string" },
                "port": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["format", "secret"],
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string",
            "enum": ["anthropic", "openai", "gemini"]
          },
          "baseUrl": { "type": "string" },
          "secret": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "key": { "type": "string" }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["providerRef", "model"],
        "additionalProperties": false,
        "properties": {
          "providerRef": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" } }
          },
          "model": { "type": "string" },
          "params": { "type": "object" }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "secretName", "image"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "secretName": { "type": "string" },
          "image": { "type": "string" }
        }
      }
    }
  }
}
