# Operator's Notion internal-integration token. Create at
# https://www.notion.com/my-integrations, copy the token, fill in below,
# rename to `notion-pat.yaml`, and `kubectl apply -f`.
#
# The chamber mounts this as the `NOTION_API_TOKEN` env var. The token grants
# whatever access the integration was granted in Notion (per-page sharing); a
# read-only chamber image is the agent-side constraint, not a Notion-side one.

apiVersion: v1
kind: Secret
metadata:
  name: notion-pat
type: Opaque
stringData:
  api-key: secret_REPLACE_WITH_NOTION_INTEGRATION_TOKEN
