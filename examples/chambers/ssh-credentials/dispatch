#!/bin/sh
# Airlock chamber dispatcher for the ssh-credentials chamber. The chamber
# mounts a demo SSH private key at /home/agent/.ssh/id_ed25519; the test-cmd
# tool emits its bytes so the transponder secret-scrubber gets exercised on
# the return path. The chamber is a test fixture, not a useful runtime tool.
set -eu

case "$1" in
    test-cmd)
        exec cat /home/agent/.ssh/id_ed25519
        ;;
    *) echo "unknown tool: $1" >&2; exit 1 ;;
esac
