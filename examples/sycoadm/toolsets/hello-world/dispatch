#!/bin/sh
# Dispatcher for the hello-world demo tools; the stdlib tools come from the
# toolset:local base image.
set -eu

case "$1" in
    GetSecret)
        # The harness lists each Secret given to this toolset and the file it
        # landed in as TOOLSET_SCRUB_SECRETS=[{"name","file"}]. The value is
        # returned as-is; the scrubber redacts it on the way back.
        file=$(printf '%s' "${TOOLSET_SCRUB_SECRETS:-[]}" |
            jq -r --arg n "$SECRET_NAME" '.[] | select(.name == $n) | .file' | head -n 1)
        if [ -z "$file" ]; then
            echo "GetSecret: no secret given to this toolset named $SECRET_NAME"
            exit 1
        fi
        exec cat "$file"
        ;;
    WebFetch)
        # No -f: an HTTP error status still exits 0 and prints the body, so a
        # non-zero exit means the request never got a response.
        err=$(mktemp)
        if curl -sS --connect-timeout 10 -- "$URL" 2>"$err"; then
            rm -f "$err"
            exit 0
        fi
        echo "WebFetch: network error: $(cat "$err")"
        rm -f "$err"
        exit 1
        ;;
    ShowKernel)
        exec dmesg
        ;;
    *) echo "unknown tool: $1" >&2; exit 1 ;;
esac
